import discord
import requests
import json
import re
import os

# Read from .env file
def load_env():
    env_vars = {}
    try:
        with open('.env', 'r') as f:
            for line in f:
                if '=' in line and not line.startswith('#'):
                    key, value = line.strip().split('=', 1)
                    env_vars[key] = value
    except FileNotFoundError:
        print("Warning: .env file not found")
    return env_vars

# Load configuration
env = load_env()
BOT_TOKEN = env.get('BOT_TOKEN')
WEBHOOK_URL = env.get('WEBHOOK_URL')
MOD_USER_IDS = env.get('MOD_USER_IDS', '').split(',')

print(f"Bot starting with webhook: {WEBHOOK_URL}")
print(f"Monitoring users: {MOD_USER_IDS}")

client = discord.Client(intents=discord.Intents.all())

@client.event
async def on_ready():
    print(f'{client.user} has connected to Discord!')

@client.event
async def on_reaction_add(reaction, user):
    if str(user.id) in MOD_USER_IDS and str(reaction.emoji) == '✅':
        if reaction.message.author.bot:
            message_content = reaction.message.content
            print(f"Processing message: {message_content}")
            
            tts_match = re.search(r'TTS#\s*(\d+)', message_content)
            filename = f"{tts_match.group(1)}.txt" if tts_match else None
            
            data = {
                "message_content": message_content,
                "user_id": str(user.id),
                "channel_id": str(reaction.message.channel.id),
                "emoji": str(reaction.emoji),
                "filename": filename
            }
            
            try:
                response = requests.post(WEBHOOK_URL, json=data)
                print(f"✅ Sent to n8n: {response.status_code}")
            except Exception as e:
                print(f"❌ Error: {e}")

if BOT_TOKEN:
    client.run(BOT_TOKEN)
else:
    print("❌ No BOT_TOKEN found in .env file")
